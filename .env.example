# Copy to .env and fill in real values. .env is gitignored.
# Usage:  uv run --env-file .env motion_generator/train.py --wandb lamp-style-model
# (wandb also reads ~/.netrc from `wandb login`, so .env is the
# portable alternative, not a requirement.)
WANDB_API_KEY=

# Dialogue LLM for the voice runtime (runtime/main.py --turn/--converse):
#   uv run --env-file .env runtime/main.py --turn "hello"
GEMINI_API_KEY=
# Motion generation service (runtime/motion/service.py on the GPU box);
# defaults to http://127.0.0.1:8031 when unset:
#MOTION_SERVICE_URL=http://gpubox:8031
