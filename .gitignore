# Python
__pycache__/
*.py[cod]
.venv/

# Cozmo dataset: raw/ is the 574MB pycozmo resource download, re-fetchable
# with `PYCOZMO_DIR=data/cozmo_data/raw pycozmo_resources.py download`
# (plus raw/cozmo_animation_labels.csv, kept in git via the exception below).
data/cozmo_data/raw/*
!data/cozmo_data/raw/cozmo_animation_labels.csv

# Regenerated deterministically from raw/ by
# data_preprocessing_pipeline/run_all.py (see REPORT.md)
data/cozmo_data/animations/

# Visualizer renders (scripts/visualize.py)
data/cozmo_data/output/

# Retargeted lamp trajectories (one run dir per `pipeline.py retarget
# --all` invocation), previews, and review GIFs -- all regenerable.
# curation.csv, CURATION.md, metrics/, and data/dataset/ stay tracked:
# the metrics CSVs are the only surviving record of mapping runs
# v1.1-v1.3 (code was iterated in place pre-git), and data/dataset/
# holds the frozen versioned exports the GPU box trains against.
data/lamp_retargeting/npz/
data/lamp_retargeting/preview/
data/lamp_retargeting/review_gifs/

# Flow-matching training runs and ad-hoc inference outputs stay local,
# EXCEPT the frozen production checkpoint, which is tracked so a fresh
# clone can run infer.py out of the box
motion_generator/runs/*
!motion_generator/runs/fm-v1/
motion_generator/runs/fm-v1/*
!motion_generator/runs/fm-v1/ckpt_best.pt
motion_generator/outputs/

# Runtime artifacts: per-run session logs
runtime/sessions/

# MuJoCo
MUJOCO_LOG.TXT

# Editor settings
.vscode/

# wandb local run logs (created by train.py --wandb)
wandb/

# Local planning notes, kept out of the repo
lamp_plan.md

# Secrets: real values live in .env (never committed); .env.example
# documents the expected variables
.env
