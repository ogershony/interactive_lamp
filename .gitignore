# Python
__pycache__/
*.py[cod]
.venv/

# Cozmo dataset: raw/ is the 574MB pycozmo resource download, re-fetchable
# with `PYCOZMO_DIR=data/cozmo_data/raw pycozmo_resources.py download`
# (plus raw/cozmo_animation_labels.csv, kept in git via the exception below).
data/cozmo_data/raw/*
!data/cozmo_data/raw/cozmo_animation_labels.csv

# Regenerated deterministically from raw/ by
# data_preprocessing_pipeline/run_all.py (see REPORT.md)
data/cozmo_data/animations/

# Visualizer renders (scripts/visualize.py)
data/cozmo_data/output/

# Retargeted lamp trajectories (one run dir per `data/pipeline.py
# retarget --all` invocation), previews, review GIFs, and exported
# datasets -- all regenerable. curation.csv, CURATION.md, and metrics/
# stay tracked: the metrics CSVs are the only surviving record of
# mapping runs v1.1-v1.3 (code was iterated in place pre-git).
data/lamp_data/npz/
data/lamp_data/preview/
data/lamp_data/review_gifs/
data/lamp_data/dataset/

# Flow-matching training runs (checkpoints live on the GPU box / local
# scratch; code and README stay tracked)
style-model/runs/

# MuJoCo
MUJOCO_LOG.TXT

# Local planning notes, kept out of the repo
lamp_plan.md
